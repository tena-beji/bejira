{
  "manifest_version": 3,
  "name": "Amazon → ヨドバシ.com リンク",
  "version": "0.1.0",
  "description": "Amazon.co.jp の商品ページに、同じ商品をヨドバシ.com で検索するリンクを表示します。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.co.jp/*/dp/*",
        "https://www.amazon.co.jp/dp/*",
        "https://www.amazon.co.jp/gp/product/*",
        "https://www.amazon.co.jp/*/gp/product/*"
      ],
      "js": ["query.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
